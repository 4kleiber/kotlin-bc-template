#!/usr/bin/env sh
# Enforce Conventional Commits format on every commit message.
# Pattern: <type>[optional scope][optional !]: <description>
commit_msg=$(cat "$1")

# Skip merge commits and fixup/squash commits
case "$commit_msg" in
  Merge\ *|Revert\ *|fixup\!*|squash\!*) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|refactor|test|perf|ci|build)(\([^)]+\))?(!)?: .+'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "ERROR: Commit message does not follow Conventional Commits format."
  echo ""
  echo "  Expected: <type>(<optional scope>): <description>"
  echo "  Example:  feat(auth): add OAuth2 login"
  echo ""
  echo "  Valid types: feat, fix, chore, docs, refactor, test, perf, ci, build"
  echo "  Breaking change: append '!' (e.g. feat!: drop support for Node 18)"
  echo ""
  echo "  Your message: $commit_msg"
  exit 1
fi
